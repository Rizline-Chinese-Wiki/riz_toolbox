<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep binary identity stable across compatible SDK 1.x releases; manifest checks SdkInfo.Version. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <PackageId>RizToolbox.Sdk</PackageId>
    <PackageVersion>1.5.0</PackageVersion>
    <Authors>Rizline Chinese Wiki</Authors>
    <Description>Compile-time contracts for the Rizline compatibility host. Runtime services are supplied by the installed host.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Rizline-Chinese-Wiki/riz_toolbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- ref-only PackageReference package: no legacy packages.config <references> group is needed.
         NU5131 is NuGet/Home#8684; Distribution.Tests verifies real restore/build and no runtime SDK copy. -->
    <NoWarn>$(NoWarn);1591;NU5131</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <BuildOutputTargetFolder>ref</BuildOutputTargetFolder>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackSdkReference</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../packaging/sdk/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="PackSdkReference">
    <Error Condition="!Exists('$(IntermediateOutputPath)ref/$(TargetFileName)')" Text="Build the SDK reference assembly before packing." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(IntermediateOutputPath)ref/$(TargetFileName)" PackagePath="ref/$(TargetFramework)" />
      <TfmSpecificPackageFile Include="$(DocumentationFile)" PackagePath="ref/$(TargetFramework)" />
    </ItemGroup>
  </Target>
</Project>
