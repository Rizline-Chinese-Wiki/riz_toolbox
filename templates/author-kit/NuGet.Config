<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="RizToolboxKit" value="sdk" />
    <add key="NuGet" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="RizToolboxKit"><package pattern="RizToolbox.Sdk" /></packageSource>
    <packageSource key="NuGet"><package pattern="Microsoft.*" /></packageSource>
  </packageSourceMapping>
</configuration>
